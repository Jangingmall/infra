{
  "uid": "janging-cnpg",
  "title": "CloudNativePG 상태",
  "description": "고정 버전의 기본 메트릭. 실제 EKS 검증 전이며 No data를 정상 상태로 바꾸지 않습니다.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "cnpg",
    "platform"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "title": "PostgreSQL 응답 상태",
      "type": "stat",
      "description": "1이면 DB exporter가 PostgreSQL에 연결 가능, 0이면 연결 불가. Prometheus 수집 상태와 구분합니다. 현재 값을 표시합니다.",
      "targets": [
        {
          "expr": "max by (namespace,pod) (cnpg_collector_up{job=\"cnpg\",namespace=\"database\",cnpg_cluster=\"jangingmall-postgres\"})",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "연결 불가",
                  "color": "red"
                },
                "1": {
                  "text": "연결 가능",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": [

        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 24
        },
        "wideLayout": false
      },
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Primary · Replica 역할",
      "type": "stat",
      "description": "0=Primary, 1=복구 모드(Replica). 실제 쓰기 서비스 연결과 복구 가능성은 별도 검증합니다. 현재 값을 표시합니다.",
      "targets": [
        {
          "expr": "max by (namespace,pod) (cnpg_pg_replication_in_recovery{job=\"cnpg\",namespace=\"database\",cnpg_cluster=\"jangingmall-postgres\"})",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Primary",
                  "color": "green"
                },
                "1": {
                  "text": "Replica",
                  "color": "blue"
                }
              }
            }
          ]
        },
        "overrides": [

        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 24
        },
        "wideLayout": false
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "DB 연결 수",
      "type": "timeseries",
      "description": "Pod별 기본 backends 쿼리의 상태/DB/사용자별 연결을 합산합니다.",
      "targets": [
        {
          "expr": "sum by (namespace,pod) (cnpg_backends_total{job=\"cnpg\",namespace=\"database\",cnpg_cluster=\"jangingmall-postgres\"})",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "DB 연결 상한 대비 사용률",
      "type": "timeseries",
      "description": "실제 max_connections 설정 대비 사용률입니다. 예약된 관리자 연결을 제외한 앱 가용 연결 수와는 다릅니다.",
      "targets": [
        {
          "expr": "100 * (sum by (namespace,pod) (cnpg_backends_total{job=\"cnpg\",namespace=\"database\",cnpg_cluster=\"jangingmall-postgres\"})) / on (namespace,pod) max by (namespace,pod) (cnpg_pg_settings_setting{job=\"cnpg\",namespace=\"database\",cnpg_cluster=\"jangingmall-postgres\",name=\"max_connections\"})",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Replica 재생 지연",
      "type": "timeseries",
      "description": "CNPG 기본 SQL이 계산하는 지연(초)입니다. 쓰기 부하/유휴 상태에 따라 해석하고 WAL receiver 상태도 함께 확인합니다.",
      "targets": [
        {
          "expr": "max by (namespace,pod) (cnpg_pg_replication_lag{job=\"cnpg\",namespace=\"database\",cnpg_cluster=\"jangingmall-postgres\"})",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
