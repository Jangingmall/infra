      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "WAL 디스크 사용량",
      "type": "timeseries",
      "description": "pg_wal 디렉터리의 바이트 수입니다. WAL 생성 속도나 S3 백업 크기를 뜻하지 않습니다.",
      "targets": [
        {
          "expr": "max by (pod) (cnpg_collector_pg_wal{job=\"cnpg\",namespace=\"database\",cnpg_cluster=\"jangingmall-postgres\",value=\"size\"})",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
