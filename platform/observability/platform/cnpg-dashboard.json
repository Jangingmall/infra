    },
    {
      "title": "CNPG PVC 사용률",
      "type": "timeseries",
      "description": "kubelet이 제공하는 볼륨 사용량입니다. CNPG DB 크기와 WAL·파일 시스템 여유는 다를 수 있습니다.",
      "targets": [
        {
          "expr": "100 * max by (namespace,persistentvolumeclaim) (kubelet_volume_stats_used_bytes{namespace=\"database\",persistentvolumeclaim=~\"jangingmall-postgres-[0-9]+(-.*)?\"}) / max by (namespace,persistentvolumeclaim) (kubelet_volume_stats_capacity_bytes{namespace=\"database\",persistentvolumeclaim=~\"jangingmall-postgres-[0-9]+(-.*)?\"})",
          "legendFormat": "{{persistentvolumeclaim}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
