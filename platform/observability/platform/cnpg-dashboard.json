    {
      "title": "기본 SQL 메트릭 수집 오류",
      "type": "stat",
      "description": "cnpg_last_error는 기본/custom SQL 쿼리 오류, collector_last_collection_error는 내부 collector 오류입니다. 값 1이면 실패입니다. 현재 값을 표시합니다.",
      "targets": [
        {
          "expr": "max by (namespace,pod) (cnpg_last_error{job=\"cnpg\",namespace=\"database\",cnpg_cluster=\"jangingmall-postgres\"})",
          "legendFormat": "{{pod}} SQL",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        },
        {
          "expr": "max by (namespace,pod) (cnpg_collector_last_collection_error{job=\"cnpg\",namespace=\"database\",cnpg_cluster=\"jangingmall-postgres\"})",
          "legendFormat": "{{pod}} collector",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
