    {
      "title": "CNPG 수집 Endpoint 상태",
      "type": "stat",
      "description": "Prometheus가 실제로 scrape했는지 확인합니다. DB 3개와 Operator를 구분합니다. 없는 대상을 성공값 0/1로 채우지 않습니다. 현재 값을 표시합니다.",
      "targets": [
        {
          "expr": "up{job=~\"cnpg|cnpg-operator\"}",
          "legendFormat": "{{job}} / {{pod}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "수집 실패",
                  "color": "red"
                },
                "1": {
                  "text": "수집 성공",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": [

        ]
      },
      "options": {
        "reduceOptions": {
