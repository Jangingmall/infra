        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "연결된 Streaming Replica",
      "type": "timeseries",
      "description": "각 Pod에 연결된 복제 수입니다. Primary는 보통 2, Replica는 0이며 장애/재구성 시 달라집니다.",
      "targets": [
        {
          "expr": "max by (namespace,pod) (cnpg_pg_replication_streaming_replicas{job=\"cnpg\",namespace=\"database\",cnpg_cluster=\"jangingmall-postgres\"})",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "트랜잭션 Commit · Rollback",
      "type": "timeseries",
      "description": "DB별 초당 처리량. Rollback에는 앱의 정상적인 취소도 포함되므로 전체를 서버 오류로 해석하지 않습니다.",
      "targets": [
        {
          "expr": "sum by (pod,datname) (rate(cnpg_pg_stat_database_xact_commit{job=\"cnpg\",namespace=\"database\",cnpg_cluster=\"jangingmall-postgres\"}[5m]))",
          "legendFormat": "{{pod}} / {{datname}} commit",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "expr": "sum by (pod,datname) (rate(cnpg_pg_stat_database_xact_rollback{job=\"cnpg\",namespace=\"database\",cnpg_cluster=\"jangingmall-postgres\"}[5m]))",
          "legendFormat": "{{pod}} / {{datname}} rollback",
          "refId": "B",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "교착 상태 발생 (15분)",
      "type": "timeseries",
      "description": "PostgreSQL deadlock 누적 카운터의 증가량입니다.",
      "targets": [
        {
          "expr": "sum by (pod,datname) (increase(cnpg_pg_stat_database_deadlocks{job=\"cnpg\",namespace=\"database\",cnpg_cluster=\"jangingmall-postgres\"}[15m]))",
          "legendFormat": "{{pod}} / {{datname}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
