{
  "uid": "janging-gpu-ai",
  "title": "GPU · AI 인프라 상태",
  "description": "L40S/T4 장치와 AI Pod 상태. AI 요청·지연·토큰 지표는 앱 계측 전까지 제공하지 않습니다.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "gpu",
    "ai"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "GPU 사용률",
      "type": "timeseries",
      "description": "GPU 장치 사용률. AI 요청 성공률을 뜻하지 않습니다. GPU 노드가 없거나 수집 전이면 No data가 정상일 수 있습니다. 0으로 대체하지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node, UUID, modelName) (DCGM_FI_DEV_GPU_UTIL{job=\"dcgm-exporter\"} < 1000000)",
          "legendFormat": "{{node}} / {{modelName}} / {{UUID}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "GPU 메모리 사용률",
      "type": "timeseries",
      "description": "FB_USED와 FB_FREE로 계산합니다. 지원하지 않는 장치의 sentinel 값은 제외합니다. GPU 노드가 없거나 수집 전이면 No data가 정상일 수 있습니다. 0으로 대체하지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (max by (node, UUID, modelName) (DCGM_FI_DEV_FB_USED{job=\"dcgm-exporter\"} < 1000000)) / ((max by (node, UUID, modelName) (DCGM_FI_DEV_FB_USED{job=\"dcgm-exporter\"} < 1000000)) + (max by (node, UUID, modelName) (DCGM_FI_DEV_FB_FREE{job=\"dcgm-exporter\"} < 1000000)))",
          "legendFormat": "{{node}} / {{modelName}} / {{UUID}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "GPU 온도",
      "type": "timeseries",
      "description": "장치별 온도입니다. 임계값과 알림은 별도 합의 후 추가합니다. GPU 노드가 없거나 수집 전이면 No data가 정상일 수 있습니다. 0으로 대체하지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node, UUID, modelName) (DCGM_FI_DEV_GPU_TEMP{job=\"dcgm-exporter\"} < 1000000)",
          "legendFormat": "{{node}} / {{modelName}} / {{UUID}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "GPU 전력 사용량",
      "type": "timeseries",
      "description": "장치별 전력 사용량입니다. GPU 노드가 없거나 수집 전이면 No data가 정상일 수 있습니다. 0으로 대체하지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node, UUID, modelName) (DCGM_FI_DEV_POWER_USAGE{job=\"dcgm-exporter\"} < 1000000)",
          "legendFormat": "{{node}} / {{modelName}} / {{UUID}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "최근 XID 오류 코드",
      "type": "timeseries",
      "description": "오류 횟수가 아닌 마지막 XID 코드입니다. rate()로 오류율을 계산하지 않습니다. GPU 노드가 없거나 수집 전이면 No data가 정상일 수 있습니다. 0으로 대체하지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node, UUID, modelName) (DCGM_FI_DEV_XID_ERRORS{job=\"dcgm-exporter\"} < 1000000)",
          "legendFormat": "{{node}} / {{modelName}} / {{UUID}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "AI Pod 준비 상태",
      "type": "timeseries",
      "description": "1이면 Ready, 0이면 준비되지 않음. 모델 요청의 성공까지 보장하지 않습니다. GPU 노드가 없거나 수집 전이면 No data가 정상일 수 있습니다. 0으로 대체하지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod) (kube_pod_status_ready{namespace=\"ai\",pod=~\"ai-(sglang|ollama)-.*\",condition=\"true\"})",
          "legendFormat": "{{pod}} {{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "AI Pod Pending",
      "type": "timeseries",
      "description": "GPU 공급 대기 등으로 아직 실행되지 않은 Pod를 확인합니다. 원인은 Events와 함께 봅니다. GPU 노드가 없거나 수집 전이면 No data가 정상일 수 있습니다. 0으로 대체하지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod) (kube_pod_status_phase{namespace=\"ai\",pod=~\"ai-(sglang|ollama)-.*\",phase=\"Pending\"})",
          "legendFormat": "{{pod}} {{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "AI 컨테이너 재시작 (15분)",
      "type": "timeseries",
      "description": "모델 재시작/충돌의 단서입니다. 원인은 로그에서 확인합니다. GPU 노드가 없거나 수집 전이면 No data가 정상일 수 있습니다. 0으로 대체하지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod,container) (increase(kube_pod_container_status_restarts_total{namespace=\"ai\",pod=~\"ai-(sglang|ollama)-.*\"}[15m]))",
          "legendFormat": "{{pod}} {{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    }
  ]
}
