          },
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{namespace=\"app\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "GC 정지시간 비율",
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
