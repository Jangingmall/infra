    },
    {
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "type": "timeseries",
      "title": "HikariCP 커넥션 풀 사용률",
      "description": "⚠️ <NAMESPACE> 교체. 아래 'DB 커넥션 풀 사용률' 패널은 Postgres 서버 쪽(pg_stat_activity) 기준이고, 이건 스프링 앱(HikariCP) 쪽 클라이언트 풀 기준이라 별도로 봐야 함 — 커넥션 누수는 보통 여기서 먼저 드러남.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_active{namespace=\"app\", pod=~\"$pod\"})\n/\nsum(hikaricp_connections_max{namespace=\"app\", pod=~\"$pod\"})\n* 100",
          "legendFormat": "HikariCP 사용률",
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
