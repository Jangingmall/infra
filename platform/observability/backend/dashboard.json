  "uid": "janging-backend-runtime",
  "id": null,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "Backend Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{namespace=\"app\",job=\"backend\"}, pod)",
        "refresh": 1,
        "includeAll": true,
        "allValue": "backend-.*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
