MIME-Version: 1.0
Content-Type: multipart/mixed; boundary="//"

--//
Content-Type: text/x-shellscript; charset="utf-8"

#!/bin/bash
# =============================================================================
# Node SSH hardening - security measure P2-1
# Targets: Ansible SSH-001 / SSH-004 / SSH-005
#          (SSH-010 clears automatically once these three pass)
# Basis:   ansible-jangin-staging-20260923-002 (FAIL 28 = 7 nodes x 4 items)
#
# ASCII ONLY - do not put non-ASCII characters in this part.
# cloud-init silently drops the whole part on a Latin-1 byte, so the script
# never runs. Rationale in Korean sits above user_data in ../../main.tf.
# Verify before every apply:  python3 scripts/check_node_user_data.py
# =============================================================================
set -euo pipefail

DROPIN=/etc/ssh/sshd_config.d/00-jangin-hardening.conf
MARKER=/var/log/jangin-hardening.failed

install -d -m 0755 /etc/ssh/sshd_config.d

cat > "$DROPIN" <<'CONF'
# The 00- prefix is deliberate.
# sshd merges drop-ins first-obtained-value-wins, the opposite of nginx and
# systemd. A conventional number such as 60- would be overridden by the
# existing configuration and have no effect.
PermitRootLogin no
MaxAuthTries 4
X11Forwarding no
CONF

chmod 0600 "$DROPIN"

# Restart only when the syntax check passes.
# restart, not reload: Ansible SSH-009 checks that no sshd_config file is
# newer than the sshd activation time. reload does not refresh
# ActiveEnterTimestamp, so the drop-in would stay newer and flip SSH-009 from
# PASS to FAIL. restart refreshes it.
if /usr/sbin/sshd -t; then
  systemctl restart sshd
  rm -f "$MARKER"
else
  # Do not fail the node boot.
  # exit 1 here would keep the node out of the cluster over one sshd setting.
  # Revert the drop-in and leave a marker so the Ansible re-check surfaces it.
  rm -f "$DROPIN"
  echo "[jangin-hardening] sshd -t FAILED at $(date -Is) - drop-in reverted" > "$MARKER"
fi

exit 0

--//--
