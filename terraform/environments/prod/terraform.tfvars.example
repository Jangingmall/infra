# =====================================================
# terraform.tfvars.example — prod 환경의 실제 값 (예시)
# ------------------------------------------------------------
# 사용법:
#   cp terraform.tfvars.example terraform.tfvars
#   (terraform.tfvars 는 .gitignore 로 커밋이 막혀 있습니다 — 작업 규칙 3)
#
# 왜 파일이 하나인가 (B안 · 2026-09-15 파트장 확정):
#   Terraform 이 자동으로 읽는 변수 파일은 terraform.tfvars 와
#   *.auto.tfvars 뿐입니다. vpc.tfvars / ecr.tfvars 처럼 나누면
#   terraform plan -var-file=... -var-file=... 를 매번 붙여야 하고,
#   🔴 하나 빠뜨리면 에러가 아니라 variable 의 default 값으로
#      조용히 넘어갑니다. CI 에서 특히 위험합니다.
#
# staging 과 다른 값은 아래 5개뿐입니다 (backend.tf 의 key 포함하면 6개):
#   env / vpc_cidr / vpc_subnet_cidrs / eks_cluster_name
# =====================================================

# ---------- 공통 (전 모듈이 씀 · 접두사 없음) ----------
project = "jangin"
env     = "prod" # staging 환경에서는 "staging"
region  = "ap-northeast-2"

# ---------- network 모듈 (vpc_ 접두사) ----------
vpc_cidr = "10.0.0.0/16" # staging: 10.1.0.0/16

# 2 AZ 인 이유: ALB 가 최소 2개 AZ 의 서브넷을 요구합니다.
# 실제 리소스는 MVP 방침상 AZ-a 에만 배치합니다.
vpc_az_suffixes = ["a", "c"]

# 🔴 app 계층만 /20 입니다.
#    EKS VPC CNI 는 Pod 하나마다 VPC 의 실제 IP 를 하나씩 줍니다.
#    /24(약 250개)로는 Pod 가 늘면 IP 가 고갈되고,
#    CIDR 은 서브넷 생성 후 절대 바꿀 수 없습니다.
#    → /24 로 "정리"하지 마세요. (검수 체크리스트 #1)
vpc_subnet_cidrs = {
  public = {
    a = "10.0.0.0/24"
    c = "10.0.1.0/24"
  }
  app = {
    a = "10.0.16.0/20" # 🔴 /20
    c = "10.0.32.0/20" # 🔴 /20
  }
  data = {
    a = "10.0.2.0/24"
    c = "10.0.3.0/24"
  }
}

# ---------- eks 모듈 (eks_ 접두사) ----------
# 현재는 서브넷의 kubernetes.io/cluster/<이름> 태그에만 쓰입니다.
# ⑥ EKS 생성 단계에서 실제 클러스터 이름과 일치하는지 반드시 대조하세요.
eks_cluster_name = "jangin-prod-eks-cluster" # staging: jangin-staging-eks-cluster

# ---------- ⑥ EKS 클러스터 (eks_ 접두사)  💰 유료 ----------
# ✅ 아래 3개는 9/16~9/17 회의에서 전부 확정됐습니다 (CLAUDE.md 「9/17 해소된 것」).

# 🔴 확정값이지만 되돌릴 수 없는 결정입니다(올릴 수만 있고 내릴 수 없음).
#    확인: aws eks describe-cluster-versions --region ap-northeast-2 --profile jangin --output table
#    기준: STANDARD_SUPPORT + AWS 기본(default) 버전. 확장 지원 구간은 추가 요금.
eks_cluster_version = "1.35" # ✅ 9/17 팀 확정. 🔴 apply 전 STANDARD_SUPPORT·애드온 호환 확인

# ✅ 권한 명부 위치. 좁히는 방향으로만 변경 가능(되돌리기 불가).
#    구 방식(CONFIG_MAP)은 aws-auth 오타 하나로 전원이 잠기는 사고가 잦습니다.
eks_authentication_mode = "API"                  # ✅ 9/16 파트장 확정

# 🔴 생성자 자동 관리자 권한.
#    ⚠️ 9/15~17 한시적 admin 회수와 충돌 주의 — 회수 후에도 남는 역할로 apply 할 것
eks_bootstrap_creator_admin = true

# ✅ 9/17 파트장 확정 — 단계 운영(B안). 전환은 재생성 없이 몇 분.
#    "공개"라도 인증 명부에 없으면 401 입니다. Public = 무방비가 아닙니다.
eks_endpoint_public_access  = true                 # B안: 9/18~20 열고, 9/21 false 로 전환
eks_endpoint_private_access = true
# 🔴 팀원 IP 를 반드시 채우세요. 빈 목록이면 apply 가 막힙니다(의도).
#    각자 확인: curl ifconfig.me
#    9/21 private only 전환 시 public_access = false + 빈 목록으로 되돌립니다.
eks_public_access_cidrs = [
  # "1.2.3.4/32",  # 강윤주
  # "1.2.3.4/32",  # 신준한
  # "1.2.3.4/32",  # 박명수
  # "1.2.3.4/32",  # 이창원
  # "1.2.3.4/32",  # 박다정
]

# 비워 둡니다 — EKS 가 eks-cluster-sg-<이름> 을 자동 생성합니다.
eks_additional_security_group_ids = []

# 감사 로그 (보안팀 상쇄 조치 #1). 💰 CloudWatch Logs 요금 발생
eks_enabled_log_types  = ["api", "audit", "authenticator"]
eks_log_retention_days = 30

# ⑧ KMS 단계에서 채웁니다. 🔴 생성 후 해제 불가.
eks_secrets_kms_key_arn = null

# ---------- ⑤ NAT Gateway (nat_ 접두사)  💰 유료 ----------
# 🔴 apply 는 9/18 일괄 (작업 규칙 17). 그전에는 plan 까지만.
#
# 비용 절감 스위치: 10/1~10/4 환경을 내릴 때 false 로 바꾸면
# NAT 만 사라지고 EIP(고정 공인 IP)는 남습니다.
# → 다시 올려도 같은 IP → 스마트택배 allowlist 유지 (작업 규칙 12)
nat_enabled = true

# AZ-a 단일. 🔴 이 AZ 장애 시 아웃바운드 전체 중단 (보안팀 NAT 조건 #5)
nat_gateway_az = "a"

# CloudWatch 알람(ErrorPortAllocation · PacketsDropCount) 알림 수신처.
# 🟡 Budget 알림 SNS 재사용 여부 미확정 → 빈 목록.
#    빈 목록이어도 지표 수집·알람 상태 표시는 정상 동작합니다.
nat_alarm_sns_topic_arns = []

# ---------- ecr 모듈 (ecr_ 접두사) ----------
# 🔗 이창원님 담당 (PR #12). 현재 값은 ecr.tfvars.json.example 에 있습니다.
#    B안 전환에 따라 이 파일로 합쳐질 예정이며,
#    파트장님이 9/16 에 직접 정리하신다고 하셨으므로 인프라가 임의로 옮기지 않습니다.
#
# ecr_enabled              = false   # 🔴 공용 ECR State 위치 확정 후 한쪽만 true
ecr_repositories = ["jangin-app", "jangin-ai/sglang", "jangin-ai/ollama"]
# ecr_keep_last_images     = 10
# ecr_untagged_expire_days = 7
# ecr_kms_key_arn          = null

# ---------- ⑦ 노드그룹 (nodes_ 접두사)  💰 유료 ----------
#
# 🔑 기본값(variables.tf)이 곧 확정 사양이라, 보통은 이 블록을 쓰지 않아도 됩니다.
#    아래는 "무엇을 바꿀 수 있는지" 보여주는 예시입니다.
#
# 🔴 GPU 를 켤 때
#      desired_size = 0 → 1 로만 바꾸고 apply 합니다.
#      💰 g6e $2.29/h + g4dn $0.65/h. 테스트 끝나면 반드시 0 으로 되돌립니다.
#
# 🔴 10/1~10/4 노드 내릴 때
#      system·app·db 의 desired_size·min_size 를 함께 0 으로.
#      enabled=true와 max_size는 유지한다. DB 재개 시 min/desired를 함께 3 이상으로 복원.
#      DB 백업·종료 확인 후 실행한다. DB 1~2대 부분 축소는 계속 금지한다.
#      ⚠️ DB 는 전부 내렸다 전부 올려야 합니다. 부분 축소는 복구가 안 됩니다
#         (CNPG podAntiAffinityType=required).
#      ⚠️ private only 상태에서 노드를 0 으로 만들면 SSM 으로 들어갈 노드가
#         사라져 클러스터 접근이 끊깁니다. 컨트롤플레인만 유지한다는 뜻을 알고 내립니다.
#
# nodes_groups = { ... }          # variables.tf 의 default 를 통째로 덮어씁니다
# nodes_extra_policy_arns = []
# nodes_ssh_key_name      = null

# ---------- s3-images / CloudFront ----------
route53_zone_id = "Z0716475DPEIGVH3RV5J"


# ---------- ⑩ EDGE: 환경별 API ALB + ACM/DNS + REGIONAL WAF ----------
alb_domain_name = "api.midam.store"
# route53_zone_id와 같은 Public Hosted Zone을 사용한다(ALB 자체 zone_id와 구분).
# Hosted Zone ID는 인증정보가 아니며 DNS 변경에는 별도 AWS 인증/IAM 권한이 필요하다.
alb_zone_id = "Z0716475DPEIGVH3RV5J"
# 가정: 최초 배포는 기존 Count → Block 절차. count에서는 요청을 차단하지 않는다.
# 오탐 확인 후 담당자가 block 전환. 두 환경의 모드는 각각 변경할 수 있다.
waf_rule_mode = "count"
waf_managed_rule_groups = [
  { name = "AWSManagedRulesCommonRuleSet", priority = 1 },
  { name = "AWSManagedRulesSQLiRuleSet", priority = 2 },
]
# TODO(BE/파트장): SSE idle timeout 확정 필요(기존 기본60초 유지).
# apply 후 terraform output -json backend_networking으로 TGB 인계값 확인.
# 네이티브의 Controller/IRSA/CRD와 TargetGroupBinding 연결 전에는 Backend 트래픽 미연결.

# ---------- 2026-09-19 추가: EBS CSI Driver 활성화 (PR #32 IRSA 머지 후) ----------
# 🔴 false 면 CNPG·Redis·Prometheus 등 모든 PVC 가 Pending 에서 멈춘다.
addons_ebs_csi_enabled = true

# ============================================================
# SSM Parameter Store 직접 등록 목록 (Terraform 입력 아님)
# ============================================================
# Backend·AI 담당자가 AWS 콘솔/CLI에서 SecureString으로 등록한다.
# 암호화 키는 해당 환경의 module.kms_app CMK를 사용한다.
# 경로: /prod/backend/<키>, /prod/ai/<키>. stage overlay의 접두사는 staging이다.
# 아래는 이름·형식 참고용 주석이며 실제 값을 이 파일이나 terraform.tfvars에 넣지 않는다.
# CHANGEME는 미입력 표시다. 실제 등록 절차·소유자는 terraform/workload-secrets.md를 따른다.
# backend_ssm_parameters = {
#   "db-url"                              = "jdbc:postgresql://jangingmall-postgres-rw.database.svc.cluster.local:5432/jangingmall"
#   "db-username"                         = "jangingmall"
#   "db-password"                         = "CHANGEME" # CNPG jangingmall-postgres-app의 앱 계정 비밀번호와 동일
#   "redis-password"                      = "CHANGEME" # Redis 시작 스크립트가 요구하는 64자리 16진수, Backend와 공유
#   "jwt-secret"                          = "CHANGEME" # JWT 서명용 비밀값
#   "kakao-client-id"                     = "CHANGEME"
#   "kakao-client-secret"                 = "CHANGEME"
#   "naver-client-id"                     = "CHANGEME"
#   "naver-client-secret"                 = "CHANGEME"
#   "mail-host"                           = "CHANGEME" # SMTP 서버 주소
#   "mail-username"                       = "CHANGEME"
#   "mail-password"                       = "CHANGEME"
#   "mail-from"                           = "CHANGEME" # 발신 이메일 주소
#   "oauth-frontend-redirect-url"         = "CHANGEME" # 로그인 후 프론트 이동 URL
#   "image-base-url"                      = "CHANGEME" # 이미지 조회 기본 URL
#   "image-upload-bucket"                 = "CHANGEME" # 업로드 이미지 S3 버킷 이름
#   "image-return-bucket"                 = "CHANGEME" # 비공개 반품 이미지 S3 버킷 이름
#   "email-verification-url"              = "CHANGEME" # Backend의 공개 이메일 인증 URL
#   "email-verification-success-redirect" = "CHANGEME" # 인증 성공 후 프론트 이동 URL
#   "backend-auth-token"                  = "CHANGEME" # 상세페이지 AI → Backend 콜백, 양쪽이 같은 파라미터 조회
# }

# ai_ssm_parameters = {
#   "internal-auth-token"         = "CHANGEME" # Backend → 상세페이지 AI 요청, 콜백 토큰과 별도 값
#   "vector-db/password"          = "CHANGEME" # ai_chatbot 계정, 챗봇 API와 벡터DB가 공유
#   "vector-db/postgres-password" = "CHANGEME" # 관리자 계정, ai-vector-db-sa만 조회
# }

# 프로비저닝 담당자가 적용 후 irsa_role_arns의 backend/ai/redis/ai-vector-db를 인계한다.
# 네이티브는 실제 ARN을 해당 환경의 ServiceAccount annotation에 연결한 뒤 CSI 마운트를 검증한다.
# SSM 등록만으로 기존 DB 비밀번호가 바뀌지는 않는다. DB 계정 변경과 Pod 재시작을 함께 조율한다.
