project = "jangin"
env     = "staging"
region  = "ap-northeast-2"

vpc_cidr        = "10.1.0.0/16"
vpc_az_suffixes = ["a", "c"]
vpc_subnet_cidrs = {
  public = {
    a = "10.1.0.0/24"
    c = "10.1.1.0/24"
  }
  app = {
    a = "10.1.16.0/20"
    c = "10.1.32.0/20"
  }
  data = {
    a = "10.1.2.0/24"
    c = "10.1.3.0/24"
  }
}

eks_cluster_name = "jangin-staging-eks-cluster"
# ✅ 9/17 팀 확정 — prod·staging 동일 버전.
eks_cluster_version = "1.35" # ✅ 9/17 팀 확정. 🔴 apply 전 STANDARD_SUPPORT·애드온 호환 확인
# ✅ 인증 모드는 9/16 확정(API). 🟡 남은 것: 생성자 관리자 권한·apply 주체 (박다정)
eks_authentication_mode     = "API"                  # ✅ 9/16 파트장 확정
eks_bootstrap_creator_admin = true
# ✅ 9/17 팀 확정 — B안(public+IP 제한) → 9/21 private only.
#    🟡 남은 것: staging 은 9/21~23 DAST 스캐너 IP 추가 (보안팀)
eks_endpoint_public_access        = true                 # B안: 9/18~20 열고, 9/21 false 로 전환
eks_endpoint_private_access       = true
# 🔴 팀원 IP 를 반드시 채우세요. 빈 목록이면 apply 가 막힙니다(의도).
#    각자 확인: curl ifconfig.me
#    9/21 private only 전환 시 public_access = false + 빈 목록으로 되돌립니다.
eks_public_access_cidrs = [
  # "1.2.3.4/32",  # 강윤주
  # "1.2.3.4/32",  # 신준한
  # "1.2.3.4/32",  # 박명수
  # "1.2.3.4/32",  # 이창원
  # "1.2.3.4/32",  # 박다정
]
eks_additional_security_group_ids = []
eks_enabled_log_types             = ["api", "audit", "authenticator"]
eks_log_retention_days            = 30
# TODO(staging 값 확정): 보안팀 — staging CMK ARN 주입; null은 미확정.
eks_secrets_kms_key_arn = null

nat_enabled    = true
nat_gateway_az = "a"
# TODO(staging 값 확정): 파트장 — NAT 알림 SNS ARN 주입; 빈 목록은 미연결.
nat_alarm_sns_topic_arns = []

# TODO(staging 값 확정): Q-PL-02 — 공용 ECR 소유 state 확정 전 false 유지.
ecr_enabled              = false
ecr_repositories         = ["jangin-app", "jangin-ai/sglang", "jangin-ai/ollama"]
ecr_keep_last_images     = 10
ecr_untagged_expire_days = 7
ecr_kms_key_arn          = null
ecr_tags                 = {}
