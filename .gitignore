# Terraform
**/.terraform/*
.terraform/
*.tfstate
*.tfstate.*

# Terraform lock 파일 
.terraform.lock.hcl

# Terraform variable 파일
terraform.tfvars
*.auto.tfvars

# Sensitive 파일
secrets.tfvars
*.pem
*.key

# OS 파일
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
.env
*.env

*.tar.gz
helm
kubectl
linux-amd64/
tfplan

# ============================================================
# 2026-09-12 추가 (신준한) — 기존 규칙은 그대로 두고 덧붙임
# ============================================================

# State 백업본 (terraform이 자동 생성)
*.tfstate.backup

# tfvars 전체 차단 — 기존 terraform.tfvars/*.auto.tfvars 보다 넓게
*.tfvars
*.tfvars.json
# 단, 값이 빈 예시 파일은 커밋해서 팀원이 보고 채우게 함
!*.tfvars.example

# plan 산출물 (바이너리 안에 민감값 포함)
*.tfplan

# override 파일 (로컬 임시 덮어쓰기)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# terraform CLI 설정 (토큰 포함 가능)
.terraformrc
terraform.rc
crash.log
crash.*.log

# 자격증명 추가분
*.p12
credentials
kubeconfig
*.kubeconfig

# Claude Code 개인 권한 승인 기록 (사람마다 다름 — 공유 안 함)
.claude/settings.local.json

